node_modules/

# The ledger is a shared fact, not run data: it is committed.
# Only the transient lock is ignored.
.deed/log/lock

# Screenshots of the board are working notes, not part of the deliverable.
.shots/

# Test workspaces when TEMP is not usable. Not a deliverable.
.deed-test/

# os.tmpdir() 在这台机器上会回 "undefined\temp"：拿它拼路径就会写进仓库根目录。
# 真的临时目录不存在时就该落 .deed-test/，这一条只是兜住手写脚本的那一下。
/undefined/
/%SystemDrive%/

# Scratch workspaces used while proving a behavior by hand (drift checks etc.).
.tmp/

# Archify diagram working directory and its run receipts (the spec and the HTML are the deliverables).
.archify/
/docs/deed-architecture.delivery.json
/docs/deed-architecture.finalize.json
/docs/deed-architecture.finalize-summary.json
/docs/deed-architecture.browser-check.json
